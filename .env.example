# ==============================================================
# NuttyTales.com — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ==============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Nutty Tales"
NEXT_PUBLIC_APP_DESCRIPTION="Premium Dry Fruits. Wholesale & Retail."

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# --- Resend (Email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=orders@nuttytales.com

# --- WhatsApp ---
NEXT_PUBLIC_WHATSAPP_NOIDA=+919717161809
NEXT_PUBLIC_WHATSAPP_KASHMIR=+919717161809
NEXT_PUBLIC_WHATSAPP_PATNA=+919717161809
NEXT_PUBLIC_WHATSAPP_SUPPORT=+919717161809

# --- Phone Numbers (admin-configurable) ---
NEXT_PUBLIC_PHONE_NOIDA=+919717161809
NEXT_PUBLIC_PHONE_KASHMIR=+919717161809
NEXT_PUBLIC_PHONE_PATNA=+919717161809
NEXT_PUBLIC_PHONE_SUPPORT=+919717161809

# --- FSSAI ---
NEXT_PUBLIC_FSSAI_NUMBER=22724441000048

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Google Tag Manager ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Supabase Database & Storage (Project: qezkjbzmtfjjmqgzgili) ---
NEXT_PUBLIC_SUPABASE_URL=https://qezkjbzmtfjjmqgzgili.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Admin Secret (for protected admin routes) ---
ADMIN_SECRET=nuttytales_admin_super_secret_2026

# --- Upload (Supabase Storage bucket) ---
NEXT_PUBLIC_STORAGE_BUCKET=nuttytales-assets
NEXT_PUBLIC_CDN_URL=https://qezkjbzmtfjjmqgzgili.supabase.co/storage/v1/object/public/nuttytales-assets

# --- Firebase Auth (Google & Phone OTP) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

